PORT=3000
HOST=127.0.0.1

# The model folder is one level above this backend folder (Full Fine-Tune).
MODEL_DIR=..

# LoRA merged model (WER 38.91%) — relative to backend folder
LORA_MODEL_DIR=../../../models/LORAmodel/lora-merged-final

# These options are used in later phases.
LANGUAGE=Hindi
TASK=transcribe
STORAGE_ENABLED=false
DATABASE_PROVIDER=sqlite
DATABASE_URL=./data/transcripts.db
STORE_AUDIO=false
